<RadzenCard class="@($"chat-message {Message.CssClass}")" role="article" aria-label="@(Message.Role == Role.User ? "Your message" : "Assistant message")">
    <header class="chat-message-header">
        <strong>@(Message.Role == Role.User ? "You" : "Assistant")</strong>
        <time datetime="@Message.TimeStamp.ToString("O")">@Message.TimeStamp.ToString("g")</time>
    </header>
    <div class="chat-message-content" @ref=_ref>@((MarkupString)AsHtml(Message.Content))</div>
</RadzenCard>