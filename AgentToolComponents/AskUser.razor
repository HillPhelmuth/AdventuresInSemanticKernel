@implements IDisposable
@if (IsOpen)
{
    <div class="modal-overlay" @onclick=OutClick>
        <div class="window @($"{Enum.GetName(AskUserOptions.Location)?.ToLower()} {AskUserOptions.CssClasses}")" role="dialog" aria-modal="true" aria-label="@(AskUserOptions.Title ?? "User interaction")" style="@AskUserOptions.Style" @onclick:stopPropagation>

            @if (AskUserOptions.ShowCloseButton || !string.IsNullOrEmpty(AskUserOptions.Title))
            {
                <div class="modal-header">
                    <div class="text-center title">
                        @((MarkupString)AsHtml(AskUserOptions.Title))
                    </div>
                    <div>
                        @if (AskUserOptions.ShowCloseButton)
                        {
                            <button type="button" class="close" aria-label="Close dialog" @onclick="CloseSelf">&times;</button>
                        }
                    </div>
                </div>
            }

            @if (ComponentType != null)
            {
                <DynamicComponent Type="ComponentType" Parameters="AskUserParameters"></DynamicComponent>
            }
            @if (ChildContent != null)
            {
                @ChildContent
            }

        </div>
    </div>
}