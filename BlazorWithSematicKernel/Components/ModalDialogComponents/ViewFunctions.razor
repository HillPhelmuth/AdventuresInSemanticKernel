<RadzenCard>
    <RadzenDataGrid Data="@(Plugin?.GetFunctionsMetadata())" TItem="FunctionMetadata" Density="Density.Compact" AllowSorting="true" AllowFiltering="true" AllowPaging="true" PageSize="5" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn TItem="FunctionMetadata" Property="@nameof(FunctionMetadata.Name)" Title="Name" Width="25%"></RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="FunctionMetadata" Property="@nameof(FunctionMetadata.Description)" Title="Description" Width="75%"></RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>