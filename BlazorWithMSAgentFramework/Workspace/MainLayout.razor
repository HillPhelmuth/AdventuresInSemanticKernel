@inherits LayoutComponentBase
<PageTitle>Adventures in Microsoft Agent Framework</PageTitle>
<RadzenLayout class="workspace-layout">
    <RadzenHeader class="workspace-header">
        <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" aria-label="Toggle navigation" />
        <a href="/" class="workspace-brand">Adventures in Microsoft Agent Framework</a>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="_sidebarExpanded" class="workspace-sidebar">
        <nav aria-label="Main navigation">
            <RadzenPanelMenu>
                @foreach (var link in Links)
                {
                    <RadzenPanelMenuItem Text="@link.Text" Path="@link.Path" Icon="@link.Icon" Match="NavLinkMatch.All" />
                }
            </RadzenPanelMenu>
            <a class="workspace-source" href="https://github.com/HillPhelmuth/AdventuresInSemanticKernel" target="_blank" rel="noopener">Source repository</a>
        </nav>
    </RadzenSidebar>
    <RadzenBody class="workspace-body">
        <main class="workspace-content">@Body</main>
    </RadzenBody>
</RadzenLayout>
@code {
    private bool _sidebarExpanded = true;
    private static readonly (string Path, string Text, string Icon)[] Links =
    [
        ("/", "Home", "home"), ("/configuration", "Configure services", "settings"), ("/samples", "Agent Framework samples", "code"),
        ("/executeFunction", "Execute a tool", "playlist_add_check"), ("/simpleAgent", "Build an agent", "build"),
        ("/agentGroupChat", "Agent workflows and dynamic teams", "groups"),
        ("/web", "Web agent", "public"), ("/wikiChat", "Wikipedia agent", "article"), ("/docs", "Agent Framework docs", "menu_book"),
        ("/repl", "C# / Blazor REPL", "terminal"), ("/novel", "Novel writer", "edit_note"), ("/dnd", "D&D story agent", "casino"),
        ("/testEmbed", "Memory and clustering", "polyline"), ("/tokens", "Tokens and probabilities", "short_text")
    ];
}
